  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  device         PaymentDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  matchedIntent  PaymentIntent?  @relation(fields: [matchedPaymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, transactionId])
}

model WalletTransfer {
  id             String   @id @default(uuid())
  senderId       String
  recipientId    String
  amount         Float
  currency       String   @default("BDT")
  fee            Float    @default(0.0)
  netAmount      Float
  status         String   @default("COMPLETED") // COMPLETED, FAILED, REVERSED
  idempotencyKey String   @unique
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender    User @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("TransferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
}






